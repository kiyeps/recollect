# --- LLM provider (any OpenAI-compatible endpoint) -------------------------
# Recollect runs on DeepSeek V4 through an OpenAI-compatible gateway.
# DeepSeek is deliberately not Anthropic/OpenAI: open-weight model, self-hostable.
# Point this at your own gateway (Ollama, vLLM, LM Studio, OpenRouter, ...).
LLM_BASE_URL=<YOUR_LLM_BASE_URL>/v1
LLM_API_KEY=<YOUR_LLM_API_KEY>
LLM_MODEL=deepseek-v4.1-flash
LLM_MAX_TOKENS=900
LLM_TIMEOUT_MS=120000

# Optional second endpoint, tried when the primary fails twice.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=

# --- Walrus Memory credentials -------------------------------------------
# Path to the credentials file generated at https://memory.walrus.xyz
# Shape: {"delegatePrivateKey": "<64-hex>", "accountId": "0x...", "relayerUrl": "https://..."}
MEMWAL_CREDENTIALS=/home/<user>/.memwal/credentials.json

# --- Telegram channel (optional) -------------------------------------------
# Token from @BotFather. The bot is one of the chatbot's channels; the CLI
# channel works without it.
TELEGRAM_BOT_TOKEN=<YOUR_TELEGRAM_BOT_TOKEN>
# Comma-separated Telegram user ids allowed to talk to the bot. Empty = anyone.
TELEGRAM_ALLOWED_USER_IDS=
# 0 hides the "[memory saved to Walrus: ...]" receipt line.
TELEGRAM_SHOW_EVENTS=1

# --- Chat behaviour -------------------------------------------------------
# How many memories are pulled on boot, and how many facts one turn may write.
BOOT_RECALL_LIMIT=6
MAX_WRITES_PER_TURN=4
